(()=>{
const host=document.createElement('section');host.id='complete-analysis';document.querySelector('main').append(host);
host.innerHTML=`<header class="chapter-heading"><span class="chapter-number">06</span><div><h2>Development & carbon · Complete comparison</h2><p>Whole-group evidence → differences within groups → structural context → synthesis</p></div></header><div class="cp-controls"><label>Region <select id="cp-region"><option>All</option></select></label><label>Baseline <select id="cp-start"></select></label><label>End year <select id="cp-end"></select></label></div><p id="cp-status" role="status"></p><h2>01 · How did GDP and emissions change?</h2><p>Indexed lines show country medians and the middle 50%, not aggregate GDP or emissions. Absolute levels are shown separately.</p><div class="cp-grid"><article class="panel"><h3>GDP per person · baseline = 100</h3><div id="cp-gdp" class="cp-chart"></div></article><article class="panel"><h3>CO₂ per person · baseline = 100</h3><div id="cp-co2" class="cp-chart"></div></article><article class="panel"><h3>GDP per person · actual PPP levels</h3><div id="cp-gdp-level" class="cp-chart"></div></article><article class="panel"><h3>CO₂ per person · actual tonnes</h3><div id="cp-co2-level" class="cp-chart"></div></article></div><h2>02 · How much do countries differ?</h2><div class="cp-grid"><article class="panel"><h3>GDP changes · all country observations</h3><div id="cp-gdp-dist" class="cp-chart"></div></article><article class="panel"><h3>CO₂ changes · all country observations</h3><div id="cp-co2-dist" class="cp-chart"></div></article></div><article class="panel"><h3>Country × year · carbon intensity</h3><label>Group <select id="cp-heat-group"><option value="0">Developed</option><option value="1">Developing</option></select></label><label>Country order <select id="cp-order"><option value="typical">Closest to group trajectory</option><option value="outlier">Furthest from group trajectory</option><option value="name">Country A–Z</option></select></label><label>Page <select id="cp-page"></select></label><p>15 countries per page; all eligible countries remain available. Colour = change in CO₂/GDP relative to baseline. Teal = decrease, orange = increase. Click a cell to inspect its country below.</p><div id="cp-heat"></div></article><h2>03 · What structural changes accompany these pathways?</h2><p>Each chart uses its own fixed cohort with complete observations over the selected window. Counts appear in legends. Associations and accounting identities do not establish causes.</p><div class="cp-grid" id="cp-structure"></div><h2>04 · Compare groups and inspect exceptions</h2><article class="panel"><h3>Group summary · medians of country changes</h3><div id="cp-summary"></div></article><article class="panel"><h3>Country detail · growth, emissions and structural context</h3><label>Country <select id="cp-country"></select></label><div class="cp-grid"><div id="cp-case" class="cp-chart"></div><div id="cp-case-structure" class="cp-chart"></div></div><p id="cp-case-note"></p></article><p>Method: IMF WEO October 2024 fixed classification. Unclassified economies are excluded from group comparisons. GDP is constant-2021 PPP per person; CO₂ is territorial fossil/industrial emissions per person. Countries have equal weight. Missing observations are never zero-filled. Neither medians nor country counts represent population-weighted totals. Energy supply and emissions have different source boundaries; structural patterns provide context, not causal attribution.</p>`;
const st=document.createElement('style');st.textContent='#complete-analysis{margin-top:48px;border-top:2px solid #ccd9dd;padding-top:28px}#complete-analysis h2{font-size:23px;margin:28px 0 12px}#complete-analysis h3{font-size:15px;margin:0 0 10px}#complete-analysis p{font-size:13px;line-height:1.6;color:#526b76;margin:12px 0}.cp-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:16px 0}#complete-analysis .panel{padding:18px;margin-bottom:16px;min-width:0}.cp-chart{height:330px;min-width:0}.cp-controls{display:flex;gap:14px;flex-wrap:wrap}#complete-analysis select{padding:8px;border:1px solid #cad9df;background:white;border-radius:6px;margin:5px;color:#173642}#complete-analysis table{width:100%;border-collapse:collapse;font-size:12px}#complete-analysis td,#complete-analysis th{padding:10px;text-align:left;border-bottom:1px solid #e1e8eb}@media(max-width:750px){.cp-grid{grid-template-columns:1fr}#cp-summary{overflow:auto}}';document.head.append(st);
const $=x=>document.getElementById('cp-'+x),names=['Developed','Developing'],colors=['#3169c9','#d5a128'];let api,groups,years,started=false;
const cfg={responsive:true,displaylogo:false};const lay=x=>({paper_bgcolor:'#fff',plot_bgcolor:'#fff',font:{family:'Segoe UI',size:11,color:'#294551'},margin:{l:65,r:20,t:20,b:75},legend:{orientation:'h',y:-.25},...x});const fmt=x=>Number.isFinite(x)?x.toFixed(1):'—';const delta=(a,b)=>100*(b/a-1);
const metrics=[['ei','Energy intensity · kWh / PPP dollar'],['ci','Energy carbon intensity · tonnes / kWh'],['coal','Coal share · % of energy supply'],['lowcarbon','Nuclear + renewables · % of energy supply'],['manufacturing','Manufacturing · % of GDP'],['services','Services · % of GDP']];
function value(iso,y,m){const r=api.record(iso,y),e=api.energy(iso,y),s=api.sectors.get(iso)?.values[y];if(m==='gdp'||m==='co2')return r?.[m]??null;if(m==='ei')return e?.energyPerCapitaKwh>0&&r?.gdp>0?e.energyPerCapitaKwh/r.gdp:null;if(m==='ci')return e?.energyPerCapitaKwh>0&&r?.co2>0?r.co2/e.energyPerCapitaKwh:null;if(m==='coal')return e?.coalShare??null;if(m==='lowcarbon')return Number.isFinite(e?.nuclearShare)&&Number.isFinite(e?.renewablesShare)?e.nuclearShare+e.renewablesShare:null;return s?.[m==='services'?'Services':'Manufacturing']??null;}
function cohort(g,m){return g.filter(iso=>years.every(y=>Number.isFinite(value(iso,y,m))));}
function line(id,m,indexed=false){const ts=[];groups.forEach((g,i)=>{const cc=cohort(g,m).filter(iso=>!indexed||value(iso,years[0],m)>0);const stat=years.map(y=>{const v=cc.map(iso=>value(iso,y,m)*(indexed?100/value(iso,years[0],m):1));return [.25,.5,.75].map(q=>api.percentile(v,q));});ts.push({type:'scatter',x:[...years,...[...years].reverse()],y:[...stat.map(x=>x[0]),...stat.map(x=>x[2]).reverse()],fill:'toself',fillcolor:i?'rgba(213,161,40,.14)':'rgba(49,105,201,.12)',line:{width:0},hoverinfo:'skip',showlegend:false});ts.push({type:'scatter',mode:'lines',x:years,y:stat.map(x=>x[1]),name:names[i]+' (n='+cc.length+')',line:{color:colors[i],dash:i?'dash':'solid'},hovertemplate:'%{x}<br>Median %{y:.1f}<extra>%{fullData.name}</extra>'});});Plotly.react($(id),ts,lay({xaxis:{title:'Year',tickformat:'d'},yaxis:{title:indexed?'Index (baseline=100)':m==='gdp'?'PPP dollars / person':m==='co2'?'Tonnes / person':metrics.find(x=>x[0]===m)[1]}}),cfg);}
function dist(m){Plotly.react($(m+'-dist'),groups.map((g,i)=>({type:'box',name:names[i]+' (n='+g.length+')',y:g.map(iso=>delta(value(iso,years[0],m),value(iso,years.at(-1),m))),text:g.map(iso=>api.countries.get(iso).country),boxpoints:'all',jitter:.35,pointpos:0,marker:{color:colors[i],size:4},hovertemplate:'%{text}<br>%{y:.1f}%<extra></extra>'})),lay({yaxis:{title:'Change from baseline (%)'},showlegend:false}),cfg);}
function heat(){const i=+$('heat-group').value,g=groups[i],tra=iso=>years.map(y=>delta(value(iso,years[0],'co2')/value(iso,years[0],'gdp'),value(iso,y,'co2')/value(iso,y,'gdp'))),med=years.map((y,j)=>api.percentile(g.map(iso=>tra(iso)[j]),.5));const ranked=g.map(iso=>({iso,v:tra(iso),d:tra(iso).reduce((s,v,j)=>s+Math.abs(v-med[j]),0)/years.length})).sort((a,b)=>$('order').value==='name'?api.countries.get(a.iso).country.localeCompare(api.countries.get(b.iso).country):$('order').value==='outlier'?b.d-a.d:a.d-b.d);const n=Math.max(1,Math.ceil(g.length/15)),page=Math.min(+$('page').value||1,n);$('page').innerHTML=Array.from({length:n},(_,j)=>`<option>${j+1}</option>`).join('');$('page').value=page;const rr=ranked.slice((page-1)*15,page*15);$('heat').style.height=(rr.length*28+110)+'px';Plotly.react($('heat'),[{type:'heatmap',x:years,y:rr.map(r=>api.countries.get(r.iso).country),z:rr.map(r=>r.v),customdata:rr.map(r=>years.map(()=>r.iso)),zmin:-100,zmax:100,colorscale:[[0,'#137f83'],[.5,'#f5f3ed'],[1,'#e87854']],xgap:2,ygap:2,colorbar:{title:'Change %'},hovertemplate:'%{y} · %{x}<br>CO₂/GDP change %{z:.1f}%<extra></extra>'}],lay({margin:{l:175,r:65,t:15,b:55},yaxis:{autorange:'reversed'},xaxis:{title:'Year',tickformat:'d'}}),cfg).then(()=>{if($('heat').bound)return;$('heat').bound=true;$('heat').on('plotly_click',ev=>{const iso=ev.points?.[0]?.customdata;if(iso){$('country').value=iso;detail();}});});}
function summary(){const defs=[['gdp','GDP/person change','%'],['co2','CO₂/person change','%'],['ei','Energy intensity change','%'],['ci','Energy carbon intensity change','%'],['coal','Coal share change','pp'],['lowcarbon','Low-carbon share change','pp'],['manufacturing','Manufacturing share change','pp'],['services','Services share change','pp']];$('summary').innerHTML='<table><thead><tr><th>Measure</th><th>Developed median (n)</th><th>Developing median (n)</th></tr></thead><tbody>'+defs.map(([m,label,unit])=>'<tr><td>'+label+' ('+unit+')</td>'+groups.map(g=>{const cc=cohort(g,m).filter(iso=>unit==='pp'||value(iso,years[0],m)>0),v=cc.map(iso=>unit==='pp'?value(iso,years.at(-1),m)-value(iso,years[0],m):delta(value(iso,years[0],m),value(iso,years.at(-1),m)));return '<td>'+fmt(api.percentile(v,.5))+' ('+cc.length+')</td>';}).join('')+'</tr>').join('')+'</tbody></table>';}
function detail(){const iso=$('country').value;if(!iso)return;const name=api.countries.get(iso).country;Plotly.react($('case'),['gdp','co2'].map((m,i)=>({x:years,y:years.map(y=>value(iso,y,m)*100/value(iso,years[0],m)),name:m==='gdp'?'GDP/person':'CO₂/person',line:{color:i?'#e18356':'#168a8b'},hovertemplate:'%{x}<br>Index %{y:.1f}<extra>%{fullData.name}</extra>'})),lay({title:name,xaxis:{title:'Year'},yaxis:{title:'Index (baseline=100)'}}),cfg);Plotly.react($('case-structure'),['coal','lowcarbon','manufacturing','services'].map((m,i)=>({x:years,y:years.map(y=>value(iso,y,m)),connectgaps:false,name:metrics.find(x=>x[0]===m)[1].split(' · ')[0],hovertemplate:'%{x}<br>Share %{y:.1f}%<extra>%{fullData.name}</extra>'})),lay({xaxis:{title:'Year'},yaxis:{title:'Share (%)',range:[0,100]}}),cfg);$('case-note').textContent=name+': GDP/person '+fmt(delta(value(iso,years[0],'gdp'),value(iso,years.at(-1),'gdp')))+'%; CO₂/person '+fmt(delta(value(iso,years[0],'co2'),value(iso,years.at(-1),'co2')))+'%. Energy shares and GDP sector shares use different denominators; do not add the lines together. Missing source observations remain gaps.';}
function render(){const a=+$('start').value,b=+$('end').value;if(a>=b){$('status').textContent='Choose a start year before the end year.';return;}years=Array.from({length:b-a+1},(_,j)=>a+j);groups=names.map(name=>[...api.countries.keys()].filter(iso=>api.income.get(iso)===name&&($('region').value==='All'||api.countries.get(iso).region===$('region').value)&&years.every(y=>value(iso,y,'gdp')>0&&value(iso,y,'co2')>0)));$('status').textContent=`${a}–${b} · Fixed complete GDP–CO₂ cohort: ${groups[0].length} developed / ${groups[1].length} developing economies · ${$('region').value}. Independent controls for this complete panel.`;line('gdp','gdp',true);line('co2','co2',true);line('gdp-level','gdp');line('co2-level','co2');dist('gdp');dist('co2');metrics.forEach(([m])=>line(m,m));heat();summary();const old=$('country').value;$('country').innerHTML='';groups.flat().sort((a,b)=>api.countries.get(a).country.localeCompare(api.countries.get(b).country)).forEach(iso=>$('country').add(new Option(api.countries.get(iso).country,iso)));if(groups.flat().includes(old))$('country').value=old;else if(groups.flat().includes('CHN'))$('country').value='CHN';detail();}
window.addEventListener('growth-carbon-data',ev=>{api=ev.detail;if(started)return;started=true;metrics.forEach(([m,label])=>{const a=document.createElement('article');a.className='panel';const h=document.createElement('h3');h.textContent=label;const d=document.createElement('div');d.id='cp-'+m;d.className='cp-chart';a.append(h,d);$('structure').append(a);});for(const id of ['start','end'])$(''+id).innerHTML=Array.from({length:20},(_,j)=>`<option>${2005+j}</option>`).join('');$('start').value=2005;$('end').value=2024;[...new Set([...api.countries.values()].map(x=>x.region))].sort().forEach(r=>$('region').add(new Option(r,r)));for(const id of ['start','end','region'])$(id).onchange=render;for(const id of ['heat-group','order'])$(id).onchange=()=>{$('page').value=1;heat();};$('page').onchange=heat;$('country').onchange=detail;render();});
})();
