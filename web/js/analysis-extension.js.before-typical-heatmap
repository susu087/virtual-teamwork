window.addEventListener('growth-carbon-data',event=>{api=event.detail;if(ready)return;ready=true;for(const id of ['start','end'])$(id).innerHTML=Array.from({length:20},(_,i)=>`<option>${2005+i}</option>`).join('');$('start').value=2005;$('end').value=2024;for(const region of [...new Set([...api.countries.values()].map(x=>x.region))].sort())$('region').add(new Option(region,region));for(const id of ['start','end','region','group','path'])$(id).onchange=()=>{selected=null;render();};$('clear').onclick=()=>{selected=null;render();};$('search').oninput=()=>{$('bar-page').value=1;bars();};$('order').onchange=()=>{$('bar-page').value=1;bars();};$('bar-page').onchange=bars;$('sort').onchange=()=>{$('page').value=1;matrix();};$('page').onchange=matrix;render();});
})();
