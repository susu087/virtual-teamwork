$('page').innerHTML=Array.from({length:Math.max(1,Math.ceil(subset().length/12))},(_,i)=>`<option>${i+1}</option>`).join('');renderLinked();}
function bars(){
let rr=rows.filter(r=>r.country.toLowerCase().includes($('search').value.trim().toLowerCase()));
rr.sort((a,b)=>$('order').value==='name'?a.country.localeCompare(b.country):$('order').value==='gdp'?b.g-a.g:$('order').value==='reduction'?a.c-b.c:b.c-a.c);
const pages=Math.max(1,Math.ceil(rr.length/15)),page=Math.min(+$('bar-page').value||1,pages);$('bar-page').innerHTML=Array.from({length:pages},(_,i)=>`<option>${i+1}</option>`).join('');$('bar-page').value=page;
const shown=rr.slice((page-1)*15,page*15),labels=shown.map(r=>r.country+(r.group===0?' [H]':' [L/M]'));
const vals=rr.flatMap(r=>[r.g,r.c]),lo=Math.min(0,...vals),hi=Math.max(1,...vals),pad=(hi-lo)*.18,range=[lo-pad*.2,hi+pad];
$('scatter').style.height=Math.max(230,shown.length*38+110)+'px';
const traces=['g','c'].map((m,i)=>({type:'bar',orientation:'h',name:i?'CO₂':'GDP',x:shown.map(r=>r[m]),y:labels,customdata:shown.map(r=>r.iso),xaxis:i?'x2':'x',yaxis:i?'y2':'y',text:shown.map(r=>(r[m]>0?'+':'')+pct(r[m])+'%'),textposition:'outside',cliponaxis:false,marker:{color:i?'#e18356':'#168a8b'},hovertemplate:'%{y}<br>%{x:.1f}%<extra>%{fullData.name}</extra>'}));
Plotly.react($('scatter'),traces,layout({margin:{l:165,r:60,t:65,b:55},showlegend:false,xaxis:{domain:[0,.44],range,title:'GDP per person change (%)',zeroline:true,zerolinecolor:'#536f77'},xaxis2:{domain:[.56,1],range,title:'CO₂ per person change (%)',zeroline:true,zerolinecolor:'#536f77'},yaxis:{autorange:'reversed',categoryorder:'array',categoryarray:labels,automargin:true},yaxis2:{autorange:'reversed',categoryorder:'array',categoryarray:labels,showticklabels:false,anchor:'x2'},annotations:shown.length?[{text:'GDP per person',xref:'paper',yref:'paper',x:.22,y:1.08,showarrow:false},{text:'CO₂ per person',xref:'paper',yref:'paper',x:.78,y:1.08,showarrow:false}]:[{text:'No countries match these filters.',xref:'paper',yref:'paper',x:.5,y:.5,showarrow:false}]}),{...cfg,displayModeBar:false}).then(()=>{if($('scatter').barsBound)return;$('scatter').barsBound=true;$('scatter').on('plotly_click',ev=>{const iso=ev.points?.[0]?.customdata;if(!iso)return;selected=new Set([iso]);$('page').value='1';matrix();$('status').textContent=`${$('start').value}–${$('end').value} · ${rows.length} eligible economies · history selected: ${api.countries.get(iso).country}`;});});
$('bar-note').textContent=`${rr.length} matching economies · page ${page}/${pages} · ${shown.length} shown. Both columns use the same scale, fixed across all pages of this search. No extreme values are removed.`;
}
function matrix(){let rr=[...subset()];rr.sort((a,b)=>$('sort').value==='name'?a.country.localeCompare(b.country):b[$('sort').value==='gdp'?'g':'c']-a[$('sort').value==='gdp'?'g':'c']);const pages=Math.max(1,Math.ceil(rr.length/12)),page=Math.min(+$('page').value||1,pages);$('page').innerHTML=Array.from({length:pages},(_,i)=>`<option>${i+1}</option>`).join('');$('page').value=page;
const start=+$('start').value,end=+$('end').value,years=Array.from({length:end-start+1},(_,i)=>start+i);let vals=[100];for(const r of rr){const base=api.record(r.iso,start);for(const y of years){const p=api.record(r.iso,y);if(p)vals.push(100*p.gdp/base.gdp,100*p.co2/base.co2);}}const range=[Math.max(0,Math.min(...vals)*.95),Math.max(...vals)*1.05];
$('matrix').querySelectorAll('.ax-mini').forEach(el=>Plotly.purge(el));$('matrix').replaceChildren();for(const r of rr.slice((page-1)*12,page*12)){const card=document.createElement('div');card.className='ax-mini-card';const btn=document.createElement('button');btn.textContent=r.country;const note=document.createElement('p');note.textContent=`GDP ${pct(r.g)}% · CO₂ ${pct(r.c)}%`;const el=document.createElement('div');el.className='ax-mini';card.append(btn,note,el);$('matrix').append(card);const base=api.record(r.iso,start);Plotly.newPlot(el,['gdp','co2'].map((m,i)=>({x:years,y:years.map(y=>{const p=api.record(r.iso,y);return p?100*p[m]/base[m]:null;}),name:m==='gdp'?'GDP':'CO₂',type:'scatter',mode:'lines',connectgaps:false,line:{color:i?'#e18356':'#168a8b'}})),layout({margin:{l:45,r:8,t:5,b:35},showlegend:false,xaxis:{title:'Year',nticks:3},yaxis:{title:'Index',range}}),cfg);}}
