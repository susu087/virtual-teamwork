function matrix(){let rr=[...subset()];rr.sort((a,b)=>$('sort').value==='name'?a.country.localeCompare(b.country):b[$('sort').value==='gdp'?'g':'c']-a[$('sort').value==='gdp'?'g':'c']);const pages=Math.max(1,Math.ceil(rr.length/12)),page=Math.min(+$('page').value||1,pages);$('page').innerHTML=Array.from({length:pages},(_,i)=>`<option>${i+1}</option>`).join('');$('page').value=page;
const start=+$('start').value,end=+$('end').value,years=Array.from({length:end-start+1},(_,i)=>start+i);let vals=[100];for(const r of rr){const base=api.record(r.iso,start);for(const y of years){const p=api.record(r.iso,y);if(p)vals.push(100*p.gdp/base.gdp,100*p.co2/base.co2);}}const range=[Math.max(0,Math.min(...vals)*.95),Math.max(...vals)*1.05];
$('matrix').querySelectorAll('.ax-mini').forEach(el=>Plotly.purge(el));$('matrix').replaceChildren();for(const r of rr.slice((page-1)*12,page*12)){const card=document.createElement('div');card.className='ax-mini-card';const btn=document.createElement('button');btn.textContent=r.country;btn.onclick=()=>choose(r.iso);const note=document.createElement('p');note.textContent=`GDP ${pct(r.g)}% · CO₂ ${pct(r.c)}%`;const el=document.createElement('div');el.className='ax-mini';card.append(btn,note,el);$('matrix').append(card);const base=api.record(r.iso,start);Plotly.newPlot(el,['gdp','co2'].map((m,i)=>({x:years,y:years.map(y=>{const p=api.record(r.iso,y);return p?100*p[m]/base[m]:null;}),name:m==='gdp'?'GDP':'CO₂',type:'scatter',mode:'lines',connectgaps:false,line:{color:i?'#e18356':'#168a8b'}})),layout({margin:{l:45,r:8,t:5,b:35},showlegend:false,xaxis:{title:'Year',nticks:3},yaxis:{title:'Index',range}}),cfg);}}
function waterfalls(){if(!api)return;for(const side of ['a','b']){const iso=$(side).value,start=+$('start').value,end=+$('end').value,a=api.record(iso,start),b=api.record(iso,end),ea=api.energy(iso,start)?.energyPerCapitaKwh,eb=api.energy(iso,end)?.energyPerCapitaKwh;let traces=[];if(start<end&&a?.gdp>0&&a.co2>0&&b?.gdp>0&&b.co2>0&&ea>0&&eb>0){const v=[100*Math.log(b.gdp/a.gdp),100*Math.log((eb/b.gdp)/(ea/a.gdp)),100*Math.log((b.co2/eb)/(a.co2/ea))];traces=[{type:'waterfall',x:['GDP/person','Energy/GDP','CO₂/energy','CO₂ total'],y:[...v,0],measure:['relative','relative','relative','total'],text:[...v,v.reduce((x,y)=>x+y,0)].map(pct),textposition:'auto',hovertemplate:'%{x}: %{y:.2f} log points<extra></extra>',connector:{line:{color:'#bdced2'}}}];}Plotly.react($('water-'+side),traces,layout({title:{text:api.countries.get(iso)?.country||'Choose a country'},yaxis:{title:'Log change ×100'},annotations:traces.length?[]:[{text:'No positive matched endpoint energy / GDP / CO₂ data',xref:'paper',yref:'paper',x:.5,y:.5,showarrow:false}]}),cfg);}}
function renderLinked(){matrix();const rr=subset();const counts=groups.map((_,i)=>paths.map((_,k)=>rr.filter(r=>r.group===i&&r.k===k).length));Plotly.react($('composition'),paths.map((name,k)=>({type:'bar',name,orientation:'h',y:groups,x:groups.map((_,i)=>{const n=counts[i].reduce((a,b)=>a+b,0);return n?100*counts[i][k]/n:0;}),customdata:groups.map((_,i)=>`${counts[i][k]} / ${counts[i].reduce((a,b)=>a+b,0)}`),hovertemplate:'%{y}<br>%{customdata} economies · %{x:.1f}%<extra>%{fullData.name}</extra>'})),layout({barmode:'stack',margin:{l:150,r:20,t:25,b:100},xaxis:{title:'Share of filtered sample (%)',range:[0,100]},legend:{orientation:'h',y:-.3}}),cfg);factors();}
function factors(){const start=+$('start').value,end=+$('end').value,key=$('factor').value,rr=subset();const get=r=>{const a=api.record(r.iso,start),b=api.record(r.iso,end),ea=api.energy(r.iso,start),eb=api.energy(r.iso,end);if(key==='coal')return Number.isFinite(ea?.coalShare)&&Number.isFinite(eb?.coalShare)?eb.coalShare-ea.coalShare:null;if(key==='services'){const v=api.sectors.get(r.iso)?.values;return Number.isFinite(v?.[start]?.Services)&&Number.isFinite(v?.[end]?.Services)?v[end].Services-v[start].Services:null;}if(!(ea?.energyPerCapitaKwh>0&&eb?.energyPerCapitaKwh>0))return null;return key==='ei'?change(ea.energyPerCapitaKwh/a.gdp,eb.energyPerCapitaKwh/b.gdp):change(a.co2/ea.energyPerCapitaKwh,b.co2/eb.energyPerCapitaKwh);};const traces=[];groups.forEach((g,i)=>{const a=rr.filter(r=>r.group===i).map(r=>({...r,v:get(r)})).filter(r=>Number.isFinite(r.v)).sort((a,b)=>a.country.localeCompare(b.country));const name=`${g} (n=${a.length})`;traces.push({type:'scatter',mode:'markers',name,x:a.map(r=>r.v),y:a.map((_,j)=>i+((j%9)-4)*.025),text:a.map(r=>r.country),marker:{color:colors[i],size:8},hovertemplate:'%{text}: %{x:.2f}<extra></extra>'});if(a.length)traces.push({type:'scatter',mode:'markers',name:g+' median',x:[api.percentile(a.map(r=>r.v),.5)],y:[i],marker:{color:colors[i],symbol:'diamond',size:17,line:{color:'#173642',width:1}},hovertemplate:'Median %{x:.2f}<extra></extra>'});});Plotly.react($('factors'),traces,layout({margin:{l:150,r:20,t:25,b:100},showlegend:false,xaxis:{title:$('factor').selectedOptions[0].text},yaxis:{tickvals:[0,1],ticktext:groups.map((g,i)=>g+' (n='+traces.filter(t=>t.name===g+' median').map(t=>traces[traces.indexOf(t)-1].x.length).reduce((a,b)=>a+b,0)+')'),range:[-.4,1.4]}}),cfg);}
window.addEventListener('growth-carbon-data',event=>{api=event.detail;if(ready)return;ready=true;for(const id of ['start','end'])$(id).innerHTML=Array.from({length:20},(_,i)=>`<option>${2005+i}</option>`).join('');$('start').value=2005;$('end').value=2024;for(const region of [...new Set([...api.countries.values()].map(x=>x.region))].sort())$('region').add(new Option(region,region));for(const c of [...api.countries.values()].sort((a,b)=>a.country.localeCompare(b.country)))for(const side of ['a','b'])$(side).add(new Option(c.country,c.iso));$('a').value='CHN';$('b').value='USA';for(const id of ['start','end','region','group','path'])$(id).onchange=()=>{selected=null;render();};$('clear').onclick=()=>{selected=null;render();};$('sort').onchange=()=>{$('page').value=1;matrix();};$('page').onchange=matrix;$('factor').onchange=factors;$('a').onchange=waterfalls;$('b').onchange=waterfalls;render();});
