(()=>{
'use strict';
const host=document.createElement('section');host.id='analysis-extension';host.innerHTML=`<div class="ax-controls"><label hidden>Start year <select id="ax-start"></select></label><label hidden>End year <select id="ax-end"></select></label><label>Region <select id="ax-region"><option>All</option></select></label><label>Development group <select id="ax-group"><option value="all">All classified economies</option><option value="high">Developed</option><option value="other">Developing</option></select></label><label hidden>Pathway <select id="ax-path"><option value="all">All pathways</option><option value="0">GDP↑ CO₂↓</option><option value="1">GDP↑ CO₂↑ slower</option><option value="2">GDP↑ CO₂↑ faster / equal</option><option value="3">GDP↓ CO₂↓</option><option value="4">Other / flat GDP</option></select></label><button id="ax-clear">Show all selected case histories</button></div><p id="ax-status" aria-live="polite"></p><article><h3 class="ax-title">Carbon-intensity patterns across countries</h3><p>Carbon intensity = CO₂ per person / GDP per person. Colours show change from 2005, not total emissions. Teal = lower intensity; orange = higher intensity.</p><div class="ax-controls"><label>Country view <select id="ax-heat-mode"><option value="typical">10 closest to each group median</option><option value="unusual">10 furthest from each group median</option></select></label></div><p id="ax-heat-note" aria-live="polite"></p><h4>All eligible economies · development-group medians</h4><div id="ax-overview"></div><h4>Developed · selected cases</h4><div id="ax-heat-high"></div><h4>Developing · selected cases</h4><div id="ax-heat-low"></div><p>Country selection uses the full 2005–2024 carbon-intensity trajectory, not the endpoint rank. Click a country cell to show its GDP and CO₂ history below. Gray = missing; pale = near baseline. Values beyond ±100% use saturated colours; hover retains exact values.</p></article><article><h3 class="ax-title">Explore the selected countries over time</h3><div class="ax-controls"><label>Sort <select id="ax-sort"><option value="co2">CO₂ change ↓</option><option value="gdp">GDP change ↓</option><option value="name">Country A–Z</option></select></label><label>Page <select id="ax-page"></select></label></div><p>Selected cases · 12 countries per page; common index scale across these cases. Teal = GDP; orange = CO₂. Country names and endpoint changes are shown above each chart.</p><div id="ax-matrix"></div></article><p class="ax-note">Grouping: IMF WEO October 2024. Developed = advanced economies; developing = emerging market and developing economies. Unclassified territories are excluded from both groups. Categories are fixed across 2005–2024. Pathways use positive endpoint GDP and CO₂; intermediate missing years remain gaps. Percentage changes describe per-person measures. Source CSVs and existing charts are unchanged.</p>`;
document.querySelector('#trajectories .chapter-heading').after(host);const style=document.createElement('style');style.textContent=`#analysis-extension [hidden]{display:none!important}#analysis-extension{margin:18px 0 24px;padding:0;color:#173642}#analysis-extension>article{background:#fff;border:1px solid #dce5e9;border-radius:14px;padding:18px;margin:16px 0;overflow:hidden}.ax-title{margin:0 0 12px;padding:0 0 12px;border-bottom:1px solid #edf1f2;color:#173642;font-size:16px;font-weight:700}#analysis-extension p{font-size:13px;line-height:1.6;margin:10px 0}.ax-controls{display:flex;gap:12px;flex-wrap:wrap;margin:16px 0}.ax-controls label{display:flex;flex-direction:column;gap:5px}#analysis-extension input,#analysis-extension select,#analysis-extension button{padding:8px;border:1px solid #bdced2;border-radius:5px;background:white;color:#173642}.ax-plot{height:390px;min-width:0}.ax-pair{display:grid;grid-template-columns:1fr 1fr;gap:16px}#ax-matrix{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.ax-mini{height:210px;min-width:0}.ax-mini-card{background:white;padding:10px;border:1px solid #dce5e9;border-radius:8px}.ax-mini-card button{font-weight:700}.ax-note{border-top:1px solid #bdced2;padding-top:15px}@media(max-width:850px){#ax-matrix{grid-template-columns:repeat(2,minmax(0,1fr))}.ax-pair{grid-template-columns:1fr}}@media(max-width:540px){#ax-matrix{grid-template-columns:1fr}#analysis-extension{padding:12px}}`;document.head.append(style);
const $=id=>document.getElementById('ax-'+id), groups=['Developed','Developing'], colors=['#3169c9','#c28b12'], paths=['GDP↑ CO₂↓','GDP↑ CO₂↑ slower','GDP↑ CO₂↑ faster / equal','GDP↓ CO₂↓','Other / flat GDP'];
const cfg={responsive:true,displaylogo:false};let api,selected=null,rows=[],caseIds=null;let ready=false;
const layout=(extra={})=>({paper_bgcolor:'#fff',plot_bgcolor:'#fff',font:{family:'Segoe UI',size:12,color:'#173642'},margin:{l:70,r:25,b:65,t:45},...extra});
const change=(a,b)=>100*(b/a-1), pct=v=>Number.isFinite(v)?v.toFixed(1):'n/a';
function category(g,c){if(g>0&&c<0)return 0;if(g>0&&c>=0)return c<g?1:2;if(g<0&&c<0)return 3;return 4;}
function group(iso){const x=api.income.get(iso);return x==='Developed'?0:x?1:null;}
function subset(){return rows.filter(r=>(selected||caseIds)?(selected||caseIds).has(r.iso):true);}
function stats(iso){const a=api.record(iso,+$('start').value),b=api.record(iso,+$('end').value);if(!a||!b||a.gdp<=0||a.co2<=0||b.gdp<=0||b.co2<=0)return null;const g=change(a.gdp,b.gdp),c=change(a.co2,b.co2);return {...b,g,c,k:category(g,c),group:group(iso)};}
function render(){if(!api)return;const start=+$('start').value,end=+$('end').value;if(start>=end){$('status').textContent='Choose a start year earlier than the end year.';return;}
rows=[...api.countries.keys()].map(stats).filter(r=>r&&r.group!==null&&($('region').value==='All'||r.region===$('region').value)&&($('group').value==='all'||r.group===($('group').value==='high'?0:1))&&($('path').value==='all'||r.k===+$('path').value));
if(selected)selected=new Set([...selected].filter(iso=>rows.some(r=>r.iso===iso)));
$('status').textContent=`${start}–${end} · ${rows.length} eligible economies · ${selected?selected.size:rows.length} in linked views · ${$('region').value}`;
heatmaps();
$('page').innerHTML=Array.from({length:Math.max(1,Math.ceil(subset().length/12))},(_,i)=>`<option>${i+1}</option>`).join('');renderLinked();}
function heatmaps(){
const years=Array.from({length:20},(_,i)=>2005+i),eligible=rows.filter(r=>years.every(y=>{const p=api.record(r.iso,y);return p?.gdp>0&&p?.co2>0;}));
const trajectory=r=>{const base=api.record(r.iso,2005);return years.map(y=>{const p=api.record(r.iso,y);return 100*((p.co2/p.gdp)/(base.co2/base.gdp)-1);});};
const cohorts=groups.map((_,i)=>eligible.filter(r=>r.group===i).map(r=>({...r,values:trajectory(r)})));
const medians=cohorts.map(g=>years.map((_,j)=>g.length?api.percentile(g.map(r=>r.values[j]),.5):null));
const chosen=cohorts.map((g,i)=>g.map(r=>({...r,distance:r.values.reduce((sum,v,j)=>sum+Math.abs(v-medians[i][j]),0)/20})).sort((a,b)=>($('heat-mode').value==='typical'?a.distance-b.distance:b.distance-a.distance)||a.country.localeCompare(b.country)).slice(0,10));
const scale=[[0,'#137f83'],[.5,'#f5f3ed'],[1,'#e87854']];
function plot(id,labels,z,custom,clickable){const el=$(id);el.style.height=(Math.max(1,labels.length)*30+95)+'px';const hovertext=z.map((row,i)=>row.map((v,j)=>labels[i]+' · '+years[j]+'<br>Carbon intensity: '+pct(v)+'%'+(clickable?'<br>GDP/person: '+pct(custom[i][j][1])+'%<br>CO₂/person: '+pct(custom[i][j][2])+'%':'')));const tr={hovertext,type:'heatmap',x:years,y:labels,z,customdata:custom,zmin:-100,zmax:100,zmid:0,colorscale:scale,xgap:2,ygap:3,hoverongaps:false,colorbar:{title:'Change (%)',thickness:11,tickvals:[-100,-50,0,50,100],ticktext:['≤−100','−50','0','+50','≥+100']},hovertemplate:'%{hovertext}<extra></extra>'};Plotly.react(el,[tr],layout({margin:{l:180,r:95,t:12,b:55},xaxis:{tickmode:'array',tickvals:years.filter((_,i)=>i%2===0||i===19),tickformat:'d',title:'Year · baseline 2005 = 0%'},yaxis:{autorange:'reversed',automargin:true},annotations:labels.length?[]:[{text:'No complete trajectories match the selected filters.',xref:'paper',yref:'paper',x:.5,y:.5,showarrow:false}]}),{...cfg,displayModeBar:false}).then(()=>{if(!clickable||el.heatBound)return;el.heatBound=true;el.on('plotly_click',ev=>{const iso=ev.points?.[0]?.customdata?.[0];if(!iso)return;selected=new Set([iso]);$('page').value=1;matrix();$('status').textContent='History selected: '+api.countries.get(iso).country+' · 2005–2024';});});}
plot('overview',groups.map((g,i)=>g+' (n='+cohorts[i].length+')'),medians,null,false);
chosen.forEach((g,i)=>plot(i?'heat-low':'heat-high',g.map(r=>r.country),g.map(r=>r.values),g.map(r=>years.map(y=>{const a=api.record(r.iso,2005),b=api.record(r.iso,y);return [r.iso,change(a.gdp,b.gdp),change(a.co2,b.co2)];})),true));
const ids=new Set(chosen.flat().map(r=>r.iso));rows=eligible;if(selected&&!eligible.some(r=>selected.has(r.iso)))selected=null;caseIds=ids;$('status').textContent=`2005–2024 · ${eligible.length} eligible economies · ${ids.size} displayed cases · ${$('region').value}`;
$('heat-note').textContent=`Fixed 2005–2024 cohort · ${eligible.length} complete trajectories · Developed ${cohorts[0].length}; developing ${cohorts[1].length}. Showing ${chosen[0].length} + ${chosen[1].length} cases, ranked by mean absolute distance from the annual group medians. Group overview always uses every eligible economy.`;
}
function matrix(){let rr=[...subset()];rr.sort((a,b)=>$('sort').value==='name'?a.country.localeCompare(b.country):b[$('sort').value==='gdp'?'g':'c']-a[$('sort').value==='gdp'?'g':'c']);const pages=Math.max(1,Math.ceil(rr.length/12)),page=Math.min(+$('page').value||1,pages);$('page').innerHTML=Array.from({length:pages},(_,i)=>`<option>${i+1}</option>`).join('');$('page').value=page;
const start=+$('start').value,end=+$('end').value,years=Array.from({length:end-start+1},(_,i)=>start+i);let vals=[100];for(const r of rr){const base=api.record(r.iso,start);for(const y of years){const p=api.record(r.iso,y);if(p)vals.push(100*p.gdp/base.gdp,100*p.co2/base.co2);}}const range=[Math.max(0,Math.min(...vals)*.95),Math.max(...vals)*1.05];
$('matrix').querySelectorAll('.ax-mini').forEach(el=>Plotly.purge(el));$('matrix').replaceChildren();for(const r of rr.slice((page-1)*12,page*12)){const card=document.createElement('div');card.className='ax-mini-card';const btn=document.createElement('button');btn.textContent=r.country;const note=document.createElement('p');note.textContent=`GDP ${pct(r.g)}% · CO₂ ${pct(r.c)}%`;const el=document.createElement('div');el.className='ax-mini';card.append(btn,note,el);$('matrix').append(card);const base=api.record(r.iso,start);Plotly.newPlot(el,['gdp','co2'].map((m,i)=>({x:years,y:years.map(y=>{const p=api.record(r.iso,y);return p?100*p[m]/base[m]:null;}),name:m==='gdp'?'GDP':'CO₂',hovertemplate:'%{x:.0f}<br>Index: %{y:.1f}<extra>%{fullData.name}</extra>',type:'scatter',mode:'lines',connectgaps:false,line:{color:i?'#e18356':'#168a8b'}})),layout({margin:{l:45,r:8,t:5,b:35},showlegend:false,xaxis:{title:'Year',nticks:3},yaxis:{title:'Index',range}}),cfg);}}
function renderLinked(){matrix();}
window.addEventListener('growth-carbon-data',event=>{api=event.detail;if(ready)return;ready=true;for(const id of ['start','end'])$(id).innerHTML=Array.from({length:20},(_,i)=>`<option>${2005+i}</option>`).join('');$('start').value=2005;$('end').value=2024;for(const region of [...new Set([...api.countries.values()].map(x=>x.region))].sort())$('region').add(new Option(region,region));for(const id of ['start','end','region','group','path'])$(id).onchange=()=>{selected=null;render();};$('clear').onclick=()=>{selected=null;render();};$('heat-mode').onchange=()=>{selected=null;render();};$('sort').onchange=()=>{$('page').value=1;matrix();};$('page').onchange=matrix;render();});
})();
