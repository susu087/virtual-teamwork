(()=>{
'use strict';
const host=document.createElement('section');host.id='analysis-extension';host.innerHTML=`<div class="ax-head"><span>NEW · 新增分析</span><h2>Explore pathways, compare cases, explain differences</h2><p>Existing charts are unchanged. These views use the full eligible sample, not a fixed set of 20 countries.</p></div><div class="ax-controls"><label>Start year <select id="ax-start"></select></label><label>End year <select id="ax-end"></select></label><label>Region <select id="ax-region"><option>All</option></select></label><label>Income group <select id="ax-group"><option value="all">All classified economies</option><option value="high">High income</option><option value="other">Low / middle income</option></select></label><label>Pathway <select id="ax-path"><option value="all">All pathways</option><option value="0">GDP↑ CO₂↓</option><option value="1">GDP↑ CO₂↑ slower</option><option value="2">GDP↑ CO₂↑ faster / equal</option><option value="3">GDP↓ CO₂↓</option><option value="4">Other / flat GDP</option></select></label><button id="ax-clear">Clear brush selection</button></div><p id="ax-status" aria-live="polite"></p><article><h3 class="ax-title">NEW · 01 Growth–carbon pathway explorer</h3><p>Drag to select countries and filter the trend matrix below.</p><div id="ax-scatter" class="ax-plot"></div></article><article><h3 class="ax-title">NEW · 02 Selected-country trend matrix</h3><div class="ax-controls"><label>Sort <select id="ax-sort"><option value="co2">CO₂ change ↓</option><option value="gdp">GDP change ↓</option><option value="name">Country A–Z</option></select></label><label>Page <select id="ax-page"></select></label></div><p>12 countries per page; common index scale across the filtered sample. Teal = GDP; orange = CO₂. Country names and endpoint changes are shown above each chart.</p><div id="ax-matrix"></div></article><p class="ax-note">Grouping: World Bank FY2024 high vs low/middle income, consistent with the existing data. These are income groups, not IMF development categories. Pathways use positive endpoint GDP and CO₂; intermediate missing years remain gaps. Percentage changes describe per-person measures. Source CSVs and existing charts are unchanged.</p>`;
document.querySelector('.methods-panel').before(host);const jump=document.createElement('a');jump.href='#analysis-extension';jump.textContent='NEW · Extended analysis';jump.style.color='#946700';document.querySelector('nav').append(jump);
const style=document.createElement('style');style.textContent=`#analysis-extension{margin:40px 0;padding:24px;background:#f5fafb;border:2px solid #168a8b;border-radius:16px;color:#173642}#analysis-extension .ax-head>span,.ax-title{background:#fff0b3;color:#614400;padding:9px 14px;border-left:5px solid #e5b72f;border-radius:4px}.ax-title{margin:24px 0 10px;font-size:20px}#analysis-extension p{font-size:13px;line-height:1.6;margin:10px 0}.ax-controls{display:flex;gap:12px;flex-wrap:wrap;margin:16px 0}.ax-controls label{display:flex;flex-direction:column;gap:5px}#analysis-extension select,#analysis-extension button{padding:8px;border:1px solid #bdced2;border-radius:5px;background:white;color:#173642}.ax-plot{height:390px;min-width:0}.ax-pair{display:grid;grid-template-columns:1fr 1fr;gap:16px}#ax-matrix{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.ax-mini{height:210px;min-width:0}.ax-mini-card{background:white;padding:10px;border:1px solid #dce5e9;border-radius:8px}.ax-mini-card button{font-weight:700}.ax-note{border-top:1px solid #bdced2;padding-top:15px}@media(max-width:850px){#ax-matrix{grid-template-columns:repeat(2,minmax(0,1fr))}.ax-pair{grid-template-columns:1fr}}@media(max-width:540px){#ax-matrix{grid-template-columns:1fr}#analysis-extension{padding:12px}}`;document.head.append(style);
const $=id=>document.getElementById('ax-'+id), groups=['High income','Low / middle income'], colors=['#3169c9','#c28b12'], paths=['GDP↑ CO₂↓','GDP↑ CO₂↑ slower','GDP↑ CO₂↑ faster / equal','GDP↓ CO₂↓','Other / flat GDP'];
const cfg={responsive:true,displaylogo:false};let api,selected=null,rows=[];let ready=false;
const layout=(extra={})=>({paper_bgcolor:'#fff',plot_bgcolor:'#fff',font:{family:'Segoe UI',size:12,color:'#173642'},margin:{l:70,r:25,b:65,t:45},...extra});
const change=(a,b)=>100*(b/a-1), pct=v=>Number.isFinite(v)?v.toFixed(1):'n/a';
function category(g,c){if(g>0&&c<0)return 0;if(g>0&&c>=0)return c<g?1:2;if(g<0&&c<0)return 3;return 4;}
function group(iso){const x=api.income.get(iso);return x==='High income'?0:x?1:null;}
function subset(){return selected?rows.filter(r=>selected.has(r.iso)):rows;}
function stats(iso){const a=api.record(iso,+$('start').value),b=api.record(iso,+$('end').value);if(!a||!b||a.gdp<=0||a.co2<=0||b.gdp<=0||b.co2<=0)return null;const g=change(a.gdp,b.gdp),c=change(a.co2,b.co2);return {...b,g,c,k:category(g,c),group:group(iso)};}
function render(){if(!api)return;const start=+$('start').value,end=+$('end').value;if(start>=end){$('status').textContent='Choose a start year earlier than the end year.';return;}
rows=[...api.countries.keys()].map(stats).filter(r=>r&&r.group!==null&&($('region').value==='All'||r.region===$('region').value)&&($('group').value==='all'||r.group===($('group').value==='high'?0:1))&&($('path').value==='all'||r.k===+$('path').value));
if(selected)selected=new Set([...selected].filter(iso=>rows.some(r=>r.iso===iso)));
$('status').textContent=`${start}–${end} · ${rows.length} eligible economies · ${selected?selected.size:rows.length} in linked views · ${$('region').value}`;
const traces=groups.map((name,i)=>{const r=rows.filter(x=>x.group===i);return {type:'scatter',mode:'markers',name:`${name} (n=${r.length})`,x:r.map(x=>x.g),y:r.map(x=>x.c),text:r.map(x=>x.country),customdata:r.map(x=>x.iso),selectedpoints:selected?r.map((x,j)=>selected.has(x.iso)?j:null).filter(x=>x!==null):null,marker:{color:colors[i],size:9,symbol:i?'diamond':'circle'},hovertemplate:'%{text}<br>GDP %{x:.1f}%<br>CO₂ %{y:.1f}%<extra></extra>'};});
const values=rows.flatMap(r=>[r.g,r.c]);const lo=Math.min(0,...values),hi=Math.max(1,...values);
Plotly.react($('scatter'),traces,layout({dragmode:'select',xaxis:{title:'GDP per person change (%)',zeroline:true},yaxis:{title:'CO₂ per person change (%)',zeroline:true},shapes:[{type:'line',x0:lo,y0:lo,x1:hi,y1:hi,line:{color:'#99aeb4',dash:'dot'}}],legend:{orientation:'h',y:1.15}}),{...cfg,modeBarButtonsToAdd:['select2d','lasso2d']}).then(()=>{if($('scatter').axBound)return;$('scatter').axBound=true;$('scatter').on('plotly_selected',ev=>{if(!ev)return;selected=new Set(ev.points.map(p=>p.customdata));$('page').value='1';renderLinked();$('status').textContent=`${start}–${end} · ${rows.length} eligible · ${selected.size} selected`;})});
$('page').innerHTML=Array.from({length:Math.max(1,Math.ceil(subset().length/12))},(_,i)=>`<option>${i+1}</option>`).join('');renderLinked();}
function matrix(){let rr=[...subset()];rr.sort((a,b)=>$('sort').value==='name'?a.country.localeCompare(b.country):b[$('sort').value==='gdp'?'g':'c']-a[$('sort').value==='gdp'?'g':'c']);const pages=Math.max(1,Math.ceil(rr.length/12)),page=Math.min(+$('page').value||1,pages);$('page').innerHTML=Array.from({length:pages},(_,i)=>`<option>${i+1}</option>`).join('');$('page').value=page;
const start=+$('start').value,end=+$('end').value,years=Array.from({length:end-start+1},(_,i)=>start+i);let vals=[100];for(const r of rr){const base=api.record(r.iso,start);for(const y of years){const p=api.record(r.iso,y);if(p)vals.push(100*p.gdp/base.gdp,100*p.co2/base.co2);}}const range=[Math.max(0,Math.min(...vals)*.95),Math.max(...vals)*1.05];
$('matrix').querySelectorAll('.ax-mini').forEach(el=>Plotly.purge(el));$('matrix').replaceChildren();for(const r of rr.slice((page-1)*12,page*12)){const card=document.createElement('div');card.className='ax-mini-card';const btn=document.createElement('button');btn.textContent=r.country;const note=document.createElement('p');note.textContent=`GDP ${pct(r.g)}% · CO₂ ${pct(r.c)}%`;const el=document.createElement('div');el.className='ax-mini';card.append(btn,note,el);$('matrix').append(card);const base=api.record(r.iso,start);Plotly.newPlot(el,['gdp','co2'].map((m,i)=>({x:years,y:years.map(y=>{const p=api.record(r.iso,y);return p?100*p[m]/base[m]:null;}),name:m==='gdp'?'GDP':'CO₂',type:'scatter',mode:'lines',connectgaps:false,line:{color:i?'#e18356':'#168a8b'}})),layout({margin:{l:45,r:8,t:5,b:35},showlegend:false,xaxis:{title:'Year',nticks:3},yaxis:{title:'Index',range}}),cfg);}}
function renderLinked(){matrix();}
window.addEventListener('growth-carbon-data',event=>{api=event.detail;if(ready)return;ready=true;for(const id of ['start','end'])$(id).innerHTML=Array.from({length:20},(_,i)=>`<option>${2005+i}</option>`).join('');$('start').value=2005;$('end').value=2024;for(const region of [...new Set([...api.countries.values()].map(x=>x.region))].sort())$('region').add(new Option(region,region));for(const id of ['start','end','region','group','path'])$(id).onchange=()=>{selected=null;render();};$('clear').onclick=()=>{selected=null;render();};$('sort').onchange=()=>{$('page').value=1;matrix();};$('page').onchange=matrix;render();});
})();
